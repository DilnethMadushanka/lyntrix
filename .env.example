# LYNTRIX ENVIRONMENT CONFIGURATION

# Google Cloud Console OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Gmail Nodemailer SMTP Credentials for Real OTP Emails
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_gmail_app_password
VITE_GMAIL_USER=your_email@gmail.com
VITE_GMAIL_APP_PASSWORD=your_16_digit_gmail_app_password

# Supabase PostgreSQL Global Cloud Database
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Email Service Keys (EmailJS Fallback)
VITE_EMAILJS_SERVICE_ID=service_gmail
VITE_EMAILJS_TEMPLATE_ID=template_lyntrix
VITE_EMAILJS_PUBLIC_KEY=pub_lyntrix
